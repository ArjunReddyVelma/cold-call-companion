# =============================================================================
# Cold Call Companion — Root Environment Configuration Template
# Copy this to .env during local development. Do NOT commit secrets to Git.
# =============================================================================

# Backend Configuration
PORT=8000
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Connection
# Use the Direct PostgreSQL connection string or Transaction Pooler from Supabase:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Gemini API Configuration (Server-side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
